# Toosila Frontend Environment Configuration

# Backend API URL (must match server PORT)
REACT_APP_API_BASE_URL=http://localhost:5001/api
REACT_APP_BACKEND_URL=http://localhost:5001
REACT_APP_API_URL=http://localhost:5001

# Default language (ar = Arabic, en = English)
REACT_APP_DEFAULT_LOCALE=ar

# Disable CI strict mode for builds
CI=false

# Sentry Error Tracking (optional)
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
