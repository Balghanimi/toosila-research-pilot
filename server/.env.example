# Toosila Backend Environment Configuration
NODE_ENV=development

# Server
PORT=5001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=toosila
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_SSL=false
DATABASE_URL=postgresql://postgres:your-db-password-here@localhost:5432/toosila

# JWT Configuration (REQUIRED - generate strong random secrets)
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-generate-a-strong-random-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-generate-a-strong-random-key
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password-here
EMAIL_FROM=your-email@gmail.com

# Redis Cache Configuration
# Set to false to disable caching (use direct database queries)
# Set to true and configure REDIS_URL when Redis is available
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# OTP Verification (OTPIQ API) - REQUIRED for phone login
# Get your API key from https://otpiq.com
OTPIQ_API_KEY=your-otpiq-api-key-here

# AI Content Moderation (Anthropic Claude API)
# Get your API key from: https://console.anthropic.com/
# If not set, moderation will auto-approve all content
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=1024

# Error Tracking (Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
