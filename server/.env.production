# Production Environment Configuration
# NOTE: Real production uses Railway environment variables directly.
# This file contains placeholders only and is NOT used in Railway deployments.

NODE_ENV=production

# Server Configuration
PORT=5000
FRONTEND_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# Database Configuration
DB_HOST=your-production-database-host
DB_PORT=5432
DB_NAME=toosila_production
DB_USER=your-production-db-user
DB_PASSWORD=your-secure-production-password
DB_SSL=true

# JWT Configuration (must be 32+ chars in production)
JWT_SECRET=CHANGE-ME-generate-with-node-crypto-randomBytes-32
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=CHANGE-ME-generate-with-node-crypto-randomBytes-32
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Redis (optional)
REDIS_ENABLED=true

# Logging
LOG_LEVEL=info
